DEPLOY_TOKEN=change-me

# Watchdog : alerte mail si le NAS ne recoit plus rien du Shelly
# SMTP_USER/SMTP_PASS : compte Gmail dedie + mot de passe d'application
# (https://myaccount.google.com/apppasswords - necessite la validation en 2 etapes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
WATCHDOG_THRESHOLD_SEC=900
